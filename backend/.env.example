# Compliance Tracker - Environment variables
# Copy to .env and set values for your environment.

# Application
APP_NAME=Compliance Tracker
DEBUG=false
ENVIRONMENT=development

# API
API_V1_PREFIX=/api/v1

# Database (PostgreSQL)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/compliance_tracker
# Set to true to log SQL statements (debug only)
DATABASE_ECHO=false

# Server
HOST=0.0.0.0
PORT=8000

# Uploads (local directory for uploaded documents)
UPLOAD_DIR=uploads

# AWS (for Textract document text extraction)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# S3 bucket for multi-page PDF extraction (required for PDFs with more than one page)
AWS_S3_BUCKET=

# JWT (auth) – set a strong random secret in production
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# OpenAI (for LLM compliance field extraction: document_name, expiry_date, category)
OPENAI_API_KEY=

# Resend (certificate expiry reminder emails – do not hardcode)
RESEND_API_KEY=

# SMTP (for reminder emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
